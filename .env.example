# Copy this file to .env and fill in your real assigned values.
# .env is already git-ignored — never commit real values.

# From your bootstrap credential issuance (see ../aws-sandbox-account-access.md)
STUDENT_ID=changeme
AWS_REGION=eu-west-1
AWS_PROFILE=amalitech-sandbox

# Provisioning defaults. INSTANCE_TYPE is restricted by the script to a small
# allow-list (t2/t3 micro|small) to protect the $20 exercise budget.
INSTANCE_TYPE=t3.micro

# Optional. Leave blank to keep the security group closed to inbound traffic —
# only set this if the assigned persona brief specifically calls for SSH access.
ALLOWED_SSH_CIDR=

# Tagging taxonomy — see docs/ASSUMPTIONS_LOG.md for the rationale.
COST_CENTER=kente-retail-lab
ENVIRONMENT_TAG=sandbox
OWNER_TAG=${STUDENT_ID}

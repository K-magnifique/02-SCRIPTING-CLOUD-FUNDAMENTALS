{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchAndManageOwnDevInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/owner": "magnifique" }
      }
    },
    {
      "Sid": "ReadWriteOwnConfigBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::magnifique-kente-app-config",
        "arn:aws:s3:::magnifique-kente-app-config/*"
      ]
    },
    {
      "Sid": "ViewOwnSecurityGroupReadOnly",
      "Effect": "Allow",
      "Action": "ec2:DescribeSecurityGroups",
      "Resource": "*"
    },
    {
      "Sid": "ViewOwnInstanceLogsForDebugging",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:GetLogEvents"],
      "Resource": "arn:aws:logs:*:*:log-group:/magnifique-kente/*"
    }
  ]
}
